# Checkout map for `./ape sync` (clone if missing, fetch+checkout ref if already a nested git repo).
# Destination is path + name, e.g. src/ + Ape.Core → src/Ape.Core.
# Pin `ref` to a tag or SHA once remotes exist; `main` is temporary.
#
# Copy this file to workspace.yaml. That copy is local and is not committed.
#
core:
  name: Ape.Core
  sources:
    - url: https://github.com/aklen/ape-core
      ref: main
  path: src/
launcher:
  name: Ape.Launcher
  sources:
    - url: https://github.com/aklen/ape-launcher
      ref: main
  path: src/
modules:
  - name: Ape.Module.NetworkDiagnostics
    sources:
      - url: https://github.com/aklen/ape-module-networkdiagnostics
        ref: main
    path: src/Ape.Modules/
